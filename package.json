{
  "name": "cea-agents",
  "version": "0.1.0",
  "description": "Compiler Engineering Agent: an MCP server, CLI and agent skill that give coding agents a compiler engineer's toolbox and make them prove every claim with evidence.",
  "license": "MIT",
  "type": "module",
  "bin": { "cea": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "skills", "docs", "examples", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/docs.test.ts",
    "test:integration": "vitest run test/integration",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "compiler", "llvm", "clang", "gcc", "alive2", "agent", "skill", "miscompile", "evidence"],
  "repository": { "type": "git", "url": "git+https://github.com/hesselb20-ctrl/cea.git" },
  "homepage": "https://github.com/hesselb20-ctrl/cea#readme",
  "bugs": { "url": "https://github.com/hesselb20-ctrl/cea/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.0"
  }
}
